# Google Gemini API (with fallback support)
# Primary API key - will be tried first
GEMINI_API_KEY=your_gemini_api_key_here
# Fallback API key 2 - used if primary fails with rate limit or quota errors
GEMINI_API_KEY_2=your_gemini_api_key_2_here
# Fallback API key 3 - used if both primary and secondary fail
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_GEN_MODEL=gemini-1.5-flash

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=document-clustering-lab
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local Cache & App Settings
CACHE_DB_PATH=./data/embedding_cache.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIMILARITY_THRESHOLD=0.65
